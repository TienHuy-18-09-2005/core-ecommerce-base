# Public values only. Vite copies every VITE_ variable into the browser bundle.
VITE_API_BASE_URL=/api

# Read by vite.config.ts. This name is not prefixed with VITE_, so it stays on the dev server.
# Docker Compose sets http://nginx:80. Outside Docker, copy this file to .env.
DEV_PROXY_TARGET=http://localhost:8000

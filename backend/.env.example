APP_NAME="Đồ Điện Siêu Xịn"
APP_ENV=local
APP_KEY=
# Production must keep this false. The API hides SQL and stack traces either way;
# true still exposes debug pages for non-API errors.
APP_DEBUG=false
# URL SPA dùng cho link trong email (đặt lại mật khẩu, xác thực email)
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Host name of the Compose service. The database port is not published to the host.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=core_ecommerce
DB_USERNAME=root
# Must match DB_PASSWORD in the Compose .env beside docker-compose.yml.
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty. A host-only cookie works for both localhost and 127.0.0.1.
SESSION_DOMAIN=
# false for local HTTP. Set true when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
# lax is required for Sanctum first-party SPA cookie auth.
SESSION_SAME_SITE=lax

# Hosts of the first-party SPA, without a scheme. Include the Vite dev server.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173

# Full origins allowed to call the API with credentials. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dữ liệu demo catalog (DemoCatalogSeeder: 3 cấp danh mục, 5 thương hiệu, 30 sản phẩm).
# Để trống = chỉ seed khi APP_ENV=local. true/false để bật/tắt ở môi trường không phải production.
# KHÔNG BAO GIỜ seed khi APP_ENV=production, kể cả khi đặt true.
SEED_DEMO_DATA=

# AdminUserSeeder reads these. Leave ADMIN_PASSWORD empty to skip creating the admin.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# CustomerUserSeeder reads these. Leave CUSTOMER_PASSWORD empty to skip the demo customer.
CUSTOMER_NAME="Nguyễn Văn Khách"
CUSTOMER_EMAIL=customer@ecom.local
CUSTOMER_PASSWORD=
CUSTOMER_PHONE=0900000002

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Must match REDIS_PASSWORD in the Compose .env. Redis is started with requirepass.
REDIS_PASSWORD=
REDIS_PORT=6379

# Dev: Mailpit trong docker-compose (UI http://127.0.0.1:8025). Production: SMTP thật.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ecom.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test đồng thời chạy trên MySQL THẬT nhưng là DB tạm (container riêng, tmpfs).
  KHÔNG nằm trong phpunit.xml mặc định. Chạy qua: ./scripts/concurrency-test.sh (ở thư mục gốc repo).
  Test tự từ chối chạy nếu DB_DATABASE khác "ecom_concurrency_test" hoặc DB_HOST là "mysql" (DB dev).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:WC84oQ5861l1kYGPeFJGi0x34iJnKRGPb8my7B6bOOs="/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
    </php>
</phpunit>
